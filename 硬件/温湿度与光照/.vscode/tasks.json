{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "固件：构建 Debug",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/../../tools/build_firmware.py",
        "--project",
        "sensors"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "硬件：只读监视",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/read_sensors.py",
        "--count",
        "0"
      ],
      "problemMatcher": []
    }
  ]
}
